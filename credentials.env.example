# ==============================================================================
# HERMES E-COMMERCE - TEMPLATE DE CREDENCIAIS (.env)
# ==============================================================================
# Copie este arquivo para 'credentials.env' e preencha com seus tokens oficiais.
# NUNCA commite o arquivo 'credentials.env' no repositório.
# ==============================================================================

# --- Instagram Graph API ---
# ID da Conta Comercial/Criador no Instagram e Token de Longa Duração (60 dias)
INSTAGRAM_BUSINESS_ACCOUNT_ID=seu_instagram_business_account_id
INSTAGRAM_ACCESS_TOKEN=seu_instagram_access_token
INSTAGRAM_GRAPH_URL=https://graph.instagram.com/v21.0

# --- Shopee Open Platform / AMS (Affiliate Marketing Solution) ---
# Credenciais obtidas no Shopee Open Platform ou Portal de Afiliados
SHOPEE_APP_ID=seu_shopee_app_id
SHOPEE_SECRET_KEY=sua_shopee_secret_key
SHOPEE_SUB_ID=seu_sub_id_ou_utm_source

# --- Telegram Bot & Canais VIP ---
# Bot que publica as ofertas no canal público/VIP
TELEGRAM_BOT_TOKEN=seu_telegram_bot_token
TELEGRAM_CHAT_ID=@seu_canal_vip

# Bot de Administração/Monitoramento interno (opcional)
ADMIN_TELEGRAM_BOT_TOKEN=seu_admin_telegram_bot_token
ADMIN_TELEGRAM_CHAT_ID=seu_admin_chat_id

# --- Inteligência Artificial (OpenCode Free Models / Local LLM) ---
# Provedor padrão: 'opencode' (custo zero na nuvem) ou 'local' (llama-server local)
LLM_PROVIDER=opencode
OPENCODE_MODEL=nemotron-3.5-lightning-free
LOCAL_LLM_URL=http://127.0.0.1:18434/v1/chat/completions
LOCAL_LLM_KEY=sua_chave_local_se_houver
LOCAL_LLM_MODEL=Qwen3.6-35B-A3B-UD-Q4_K_M

# --- WhatsApp Oficial (Canal Radar de Preço Baixo) ---
WHATSAPP_CHANNEL_URL=https://whatsapp.com/channel/0029VbDwlyV1HspxTl5YNi2F
WHATSAPP_CHANNEL_NAME="Radar de Preço Baixo ⚡ Ofertas & Cupons"
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=sua_evolution_api_key
EVOLUTION_INSTANCE=RadarPrecoBaixo
WHATSAPP_CHANNEL_JID=120363xxxxxxxxxxxx@newsletter

# --- Facebook Page (Radar de Preço Baixo) ---
FACEBOOK_PAGE_ID=61595220492675
FACEBOOK_PAGE_URL=https://www.facebook.com/radar.de.preco.baixoo/
FACEBOOK_PAGE_ACCESS_TOKEN=seu_facebook_page_access_token
FACEBOOK_GRAPH_URL=https://graph.facebook.com/v21.0
